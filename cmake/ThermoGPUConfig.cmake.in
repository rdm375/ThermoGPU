@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@THERMOGPU_ENABLE_OPENMP@)
    find_dependency(OpenMP)
endif()

if(@THERMOGPU_ENABLE_CUDA@)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ThermoModelTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ThermoGPUTargets.cmake")

check_required_components(ThermoGPU)
